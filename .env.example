# PostgreSQL
POSTGRES_DB=dayu_cleanset
POSTGRES_USER=dayu
POSTGRES_PASSWORD=CHANGE_ME

# Backend
DATABASE_URL=postgresql://dayu:CHANGE_ME@postgres:5432/dayu_cleanset

# Authentication
AUTH_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD

# n8n
N8N_WEBHOOK_URL=http://n8n-app:5678/webhook/dayu-cleanset-notification
